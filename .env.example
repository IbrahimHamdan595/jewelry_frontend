# Copy to .env (gitignored) and fill in.

# Backend base URL INCLUDING its /api prefix. Server-only: the browser never
# sees it — every request goes to this app's /api, which next.config.js proxies
# to the backend so the backend's HttpOnly session cookie lands on this origin.
BACKEND_API_URL=http://localhost:8001/api

# Must match the backend's JWT_SECRET exactly (HS256). Server-only.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# Content-Security-Policy mode. Leave unset (report-only) until the logs show
# no [csp-report] lines from real traffic, then set "enforce".
# CSP_MODE=enforce

# Hosts product photos are served from (image optimizer allowlist + CSP img-src).
# Defaults to the R2 public bucket; comma-separate to add a custom domain.
# IMAGE_HOSTS=pub-5092fdb36fa84b649893cd173e4339b7.r2.dev

# When the backend moves to RS256 (NEX-54), set its public key here (SPKI PEM;
# "\n" for newlines is fine) and JWT_ALGORITHM=RS256. JWT_SECRET is then unused.
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
